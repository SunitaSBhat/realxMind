<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="../../avat/sideNav.css" rel="stylesheet" type="text/css">
    <script src="https://kit.fontawesome.com/07cd577cce.js" crossorigin="anonymous"></script>
</head>
<body>
    <div id="co1">
        <div class='belowNav'>
          <ul id="ul">
            <li class="li"><i class="fa-solid fa-house"></i><a href="/">Home</a></li>
           
            <li  class="li"><i class="fa-solid fa-users-line"></i><a href="./home.ejs">Connect</a></li>
            <% if(locals.user) { %>
              <li  class="li"><i class="fa-regular fa-address-card"></i><a href="/user/form/<%= user._id %>">Blogs by you!</a></li>
            <li  class="li"><i class="fa-solid fa-user-pen"></i><a href="/user/form/<%= user._id %>">Edit Profile</a></li>
            <li  class="li"><i class="fa-regular fa-user"></i><a href="/user/form/<%= user._id %>">My profile</a></li>
            
            <li id="logout" class="li"><i class="fa-solid fa-arrow-right-from-bracket"></i>Log Out</li>
          
            <% } else { %>
            <li  class="li"><i class="fa-regular fa-address-card"></i><a href="/user/signin">Blogs by you!</a></li>
            <li  class="li"><i class="fa-solid fa-user-pen"></i><a href="/user/signin">Edit Profile</a></li>
            <li  class="li"><i class="fa-regular fa-user"></i><a href="/user/signin">My profile</a></li>
           
            <% } %>
          </ul>
          <div class='lastWords'>
            <p>2022©logo name</p>
            <p>Developed By Sunita Bhat</p>
          </div>
        </div>
      </div>
</body>
<script src="../avat/home.js"></script>
</html>